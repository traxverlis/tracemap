# Copy to .env and fill in. Never commit the resulting file.
# Generate the secrets with:  openssl rand -hex 32

ENVIRONMENT=production

# --- Security ---------------------------------------------------------------
# Signing key for the local session tokens (required, >= 32 characters).
SECRET_KEY=
# Shared token between the API and the OSINT tool runners (required).
OSINT_RUNNER_TOKEN=

# --- PostgreSQL (never published on the host) -------------------------------
POSTGRES_DB=dim
POSTGRES_USER=dim
POSTGRES_PASSWORD=
METABASE_DB=metabase

# --- Web --------------------------------------------------------------------
FRONTEND_PORT=8080
METABASE_PORT=3000
CORS_ORIGINS=http://localhost:8080
VITE_API_BASE_URL=/api

# --- OSINT runners ----------------------------------------------------------
# Leave a URL empty to disable the corresponding tool.
MAIGRET_RUNNER_URL=http://maigret:8080
SHERLOCK_RUNNER_URL=http://sherlock:8080
HOLEHE_RUNNER_URL=http://holehe:8080
OSINT_MAX_RUNTIME=1800

# OpenOSINT is NOT started automatically: check its licence and terms of use
# first, then set the URL of your own instance here.
OPENOSINT_URL=

# Directory where Flowsint graph exports are written (Flowsint keeps its own
# datastore; PostgreSQL remains the source of truth).
FLOWSINT_EXPORT_DIR=/data/reports/flowsint

# --- Outbound HTTP ----------------------------------------------------------
# Direct outbound calls made by the API itself (WhatsMyName dataset, HIBP,
# WHOIS/DNS/TLS lookups). Disabled by default.
ALLOW_OUTBOUND_HTTP=false
# Have I Been Pwned API key (paid, optional). Without it, breach checks are off.
HIBP_API_KEY=

# --- Optional LLM -----------------------------------------------------------
# disabled | claude | openai   (the application never requires an LLM)
LLM_PROVIDER=disabled
LLM_MODEL=
LLM_API_KEY=
# Data minimisation before every call. Keep these false unless truly needed.
LLM_ALLOW_ADDRESSES=false
LLM_ALLOW_PHONE_NUMBERS=false
LLM_ALLOW_FULL_EMAILS=false

# --- Correlation ------------------------------------------------------------
# A computed score can never reach 100: only a human decision confirms a match.
CORRELATION_AUTO_MAX_SCORE=95
CORRELATION_SUGGEST_THRESHOLD=40

# --- Workers ----------------------------------------------------------------
WORKERS_ENABLED=true
WORKER_POLL_SECONDS=5
RECHECK_INTERVAL_DAYS=30

# --- Development only -------------------------------------------------------
POSTGRES_DEV_PORT=5432
BACKEND_DEV_PORT=8000
FRONTEND_DEV_PORT=5173
